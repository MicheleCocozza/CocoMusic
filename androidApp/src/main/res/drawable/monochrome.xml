<?xml version="1.0" encoding="utf-8"?>
<!--
    CocoMusic monochrome launcher icon (Android 13+ themed icons).
    System applies its own tint color; all paths should use the same fill color.
    Design: pumpkin (zucca) silhouette + music note.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Stem -->
    <path
        android:fillColor="#000000"
        android:pathData="M51,28 C51,24 57,24 57,28 L57,44 L51,44 Z" />

    <!-- Leaf / tendril -->
    <path
        android:fillColor="#000000"
        android:pathData="M57,35 C62,27 75,29 74,37 C73,44 63,41 57,35 Z" />

    <!-- Pumpkin body -->
    <path
        android:fillColor="#000000"
        android:pathData="M54,44 C69,44 83,52 83,64 C83,77 69,86 54,86 C39,86 25,77 25,64 C25,52 39,44 54,44 Z" />

    <!-- Musical note head (on body, same color - visible via shape contrast) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2"
        android:pathData="M73,68 C73,73 67,76 63,73 C59,71 59,65 63,63 C67,61 73,64 73,68 Z" />

    <!-- Musical note stem + flag -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M72,68 L72,50 C79,48 84,55 76,61" />

</vector>
