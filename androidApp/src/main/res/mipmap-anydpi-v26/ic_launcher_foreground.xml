<?xml version="1.0" encoding="utf-8"?>
<!--
    CocoMusic launcher icon foreground.
    Design: pumpkin (zucca) with a musical note.
    "Coco" derives from "cocozza" = zucca in Neapolitan dialect.
    White on transparent background; orange background is the separate layer.
    Content stays within the 72x72 safe zone (18px margin on each side of 108x108 viewport).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ===== PUMPKIN ===== -->

    <!-- Stem: narrow rounded rectangle above the body -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,28 C51,24 57,24 57,28 L57,44 L51,44 Z" />

    <!-- Leaf / tendril: small teardrop shape to the right of the stem -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M57,35 C62,27 75,29 74,37 C73,44 63,41 57,35 Z" />

    <!-- Pumpkin body: wide oval, slightly taller on sides than center top/bottom -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,44 C69,44 83,52 83,64 C83,77 69,86 54,86 C39,86 25,77 25,64 C25,52 39,44 54,44 Z" />

    <!-- Left groove: subtle vertical curve creating a pumpkin rib -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M42,45 C36,56 36,72 42,85" />

    <!-- Right groove: mirror of left groove -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#33000000"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:pathData="M66,45 C72,56 72,72 66,85" />

    <!-- ===== MUSICAL NOTE (quaver / eighth note) ===== -->
    <!-- Positioned in the upper-right area of the pumpkin body -->
    <!-- Drawn in orange (#FF6D00) to be visible against the white body -->

    <!-- Note head: small filled oval -->
    <path
        android:fillColor="#FF6D00"
        android:pathData="M73,68 C73,73 67,76 63,73 C59,71 59,65 63,63 C67,61 73,64 73,68 Z" />

    <!-- Note stem + flag: vertical line with a curved flag at the top -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF6D00"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M72,68 L72,50 C79,48 84,55 76,61" />

</vector>
